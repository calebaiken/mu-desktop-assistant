<Window x:Class="Companion.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Companion settings" Width="540" Height="650" MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Make yourself at home" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
        <StackPanel Margin="0,0,12,0">
            <Label Content="Companion _name" Target="{Binding ElementName=NameInput}" Padding="0,0,0,6" />
            <TextBox x:Name="NameInput" MaxLength="40" Padding="8" FontSize="16"
                     AutomationProperties.AutomationId="CompanionName" />
            <CheckBox x:Name="TopmostInput" Content="Keep companion above other windows" Margin="0,18,0,0" MinHeight="32" />
            <Label Content="Avatar _size" Target="{Binding ElementName=ScaleInput}" Padding="0,12,0,6" />
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Width="56" TextAlignment="Right"
                           Text="{Binding ElementName=ScaleInput, Path=Value, StringFormat={}{0:P0}}" />
                <Slider x:Name="ScaleInput" Minimum="0.75" Maximum="1.5" TickFrequency="0.05"
                        SmallChange="0.05" LargeChange="0.25" IsSnapToTickEnabled="True" MinHeight="32"
                        AutomationProperties.Name="Avatar size" AutomationProperties.AutomationId="AvatarScale" />
            </DockPanel>
            <Label Content="Companion _opacity" Target="{Binding ElementName=OpacityInput}" Padding="0,8,0,6" />
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Width="56" TextAlignment="Right"
                           Text="{Binding ElementName=OpacityInput, Path=Value, StringFormat={}{0:P0}}" />
                <Slider x:Name="OpacityInput" Minimum="0.4" Maximum="1" TickFrequency="0.05"
                        SmallChange="0.05" LargeChange="0.2" IsSnapToTickEnabled="True" MinHeight="32"
                        AutomationProperties.Name="Companion opacity" AutomationProperties.AutomationId="AvatarOpacity" />
            </DockPanel>
            <CheckBox x:Name="ReducedMotionInput" Content="Reduce motion" Margin="0,8,0,0" MinHeight="32"
                      AutomationProperties.AutomationId="ReducedMotion" />
            <TextBlock Text="High contrast keeps the companion opaque. Windows animation preferences are also respected."
                       TextWrapping="Wrap" Margin="0,6,0,0" />
            <Expander Header="Desktop behavior" Margin="0,16,0,0">
              <StackPanel Margin="0,8,0,0">
                <Label Content="_Summon shortcut" Target="{Binding ElementName=ShortcutInput}" Padding="0,0,0,6" />
                <ComboBox x:Name="ShortcutInput" MinHeight="32" AutomationProperties.Name="Summon shortcut" />
                <TextBlock Text="The shortcut and tray Show action restore mouse interaction. Starting the app again also recovers it."
                           TextWrapping="Wrap" Margin="0,6,0,8" />
                <CheckBox x:Name="ClickThroughInput" Content="Let mouse clicks pass through the companion" MinHeight="32" />
                <TextBlock Text="Applies for this session until you summon the companion."
                           TextWrapping="Wrap" Margin="0,4,0,8" />
                <CheckBox x:Name="StartupInput" Content="Start when I sign in to Windows" MinHeight="32" />
                <TextBlock x:Name="StartupStatus" TextWrapping="Wrap" Margin="0,4,0,8" />
              </StackPanel>
            </Expander>
            <Expander Header="Preview expressions" Margin="0,12,0,0">
              <StackPanel Margin="0,8,0,0">
                <TextBlock Text="Preview an expression for four seconds. These previews do not start listening or run a task."
                           TextWrapping="Wrap" Margin="0,0,0,8" />
                <ComboBox x:Name="PreviewInput" MinHeight="32" AutomationProperties.Name="Expression preview" />
                <Button Content="_Preview" Click="Preview_Click" HorizontalAlignment="Left" MinWidth="88" MinHeight="34" Margin="0,8,0,0" />
              </StackPanel>
            </Expander>
            <CheckBox x:Name="DiagnosticsInput" Content="Enable additional diagnostics" Margin="0,8,0,0" MinHeight="32" />
            <TextBlock Text="Logs contain event codes, never your name or conversation content."
                       TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="2" x:Name="StatusLabel" TextWrapping="Wrap" Margin="0,20,0,16"
                   AutomationProperties.LiveSetting="Polite" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="_Close" Click="Close_Click" MinWidth="88" MinHeight="36" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="CloseSettings" />
            <Button x:Name="SaveButton" Content="_Save" Click="Save_Click" IsDefault="True" MinWidth="88" MinHeight="36"
                    AutomationProperties.AutomationId="SaveSettings" />
        </StackPanel>
    </Grid>
</Window>
