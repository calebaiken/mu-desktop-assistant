<Window x:Class="Companion.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Companion settings" Width="520" Height="460" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Make yourself at home" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <Label Content="Companion _name" Target="{Binding ElementName=NameInput}" Padding="0,0,0,6" />
            <TextBox x:Name="NameInput" MaxLength="40" Padding="8" FontSize="16"
                     AutomationProperties.AutomationId="CompanionName" />
            <CheckBox x:Name="TopmostInput" Content="Keep companion above other windows" Margin="0,18,0,0" MinHeight="32" />
            <CheckBox x:Name="DiagnosticsInput" Content="Enable additional diagnostics" Margin="0,8,0,0" MinHeight="32" />
            <TextBlock Text="Logs contain event codes, never your name or conversation content."
                       TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
        <TextBlock Grid.Row="2" x:Name="StatusLabel" TextWrapping="Wrap" Margin="0,20,0,16"
                   AutomationProperties.LiveSetting="Polite" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="_Close" Click="Close_Click" MinWidth="88" MinHeight="36" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="CloseSettings" />
            <Button x:Name="SaveButton" Content="_Save" Click="Save_Click" IsDefault="True" MinWidth="88" MinHeight="36"
                    AutomationProperties.AutomationId="SaveSettings" />
        </StackPanel>
    </Grid>
</Window>
