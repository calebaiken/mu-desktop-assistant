<Window x:Class="Companion.Desktop.ResearchHandoffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Send to Research Lab" Width="620" Height="560" MinWidth="480" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Review research transfer" FontSize="22" FontWeight="SemiBold"/>
        <TextBox x:Name="DestinationPreview" Grid.Row="1" IsReadOnly="True" IsUndoEnabled="False" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="115" VerticalScrollBarVisibility="Auto" Margin="0,12,0,8" AutomationProperties.Name="Destination research project identity and storage"/>
        <Label Grid.Row="2" Content="Exact _request from the Chat message box" Target="{Binding ElementName=RequestPreview}"/>
        <TextBox x:Name="RequestPreview" Grid.Row="3" IsReadOnly="True" IsUndoEnabled="False" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="8" AutomationProperties.Name="Exact research request to transfer"/>
        <TextBlock Grid.Row="4" Text="Only this request is transferred. Chat history is excluded. The local Lab can persist dataset references, experiments and exports in this project. This transfer runs no model or ML action. Choose a dataset and review a new plan in the Lab before execution." TextWrapping="Wrap" Margin="0,12,0,12"/>
        <WrapPanel Grid.Row="5" HorizontalAlignment="Right">
            <Button x:Name="CancelTransferButton" Content="_Cancel" IsCancel="True" Click="Cancel_Click" MinHeight="34" Padding="16,0" Margin="0,0,8,0"/>
            <Button x:Name="ConfirmTransferButton" Content="_Confirm transfer" Click="Confirm_Click" MinHeight="34" Padding="16,0"/>
        </WrapPanel>
    </Grid>
</Window>
