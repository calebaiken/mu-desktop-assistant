<Window x:Class="Companion.Desktop.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat · Desktop Companion" Width="880" Height="720" MinWidth="640" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Grid Margin="20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid x:Name="HistoryPane" Width="190" Margin="0,0,18,0" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Saved conversations" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
            <StackPanel Grid.Row="1">
                <TextBox x:Name="SearchInput" MaxLength="120" MinHeight="32" Padding="6" AutomationProperties.Name="Search saved conversations"/>
                <Button Content="Search" Click="Search_Click" MinHeight="32" Margin="0,6,0,8"/>
            </StackPanel>
            <ListBox Grid.Row="2" x:Name="HistoryList" DisplayMemberPath="Title" SelectionChanged="HistoryList_SelectionChanged"
                     AutomationProperties.Name="Saved conversations" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                <Label Content="Conversation title" Target="{Binding ElementName=TitleInput}"/>
                <TextBox x:Name="TitleInput" MaxLength="80" MinHeight="32" Padding="6" AutomationProperties.Name="Conversation title"/>
                <WrapPanel Margin="0,6,0,0">
                    <Button x:Name="RenameButton" Content="Rename" Click="Rename_Click" MinHeight="32" Padding="8,0" Margin="0,0,6,0"/>
                    <Button x:Name="DeleteButton" Content="Delete" Click="Delete_Click" MinHeight="32" Padding="8,0"/>
                </WrapPanel>
            </StackPanel>
        </Grid>
        <Grid Grid.Column="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="ConversationHeading" Text="Your local companion" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <StackPanel Grid.Row="1" Margin="0,8,0,10">
            <WrapPanel>
                <Button x:Name="TemporaryModeButton" Content="New temporary chat" Click="TemporaryMode_Click" MinHeight="32" Padding="8,0" Margin="0,0,6,4"/>
                <Button x:Name="SavedModeButton" Content="Saved chats" Click="SavedMode_Click" MinHeight="32" Padding="8,0" Margin="0,0,0,4"/>
                <CheckBox x:Name="PlainTextToggle" Content="Plain text" VerticalAlignment="Center" Margin="10,0,0,4" Checked="TranscriptView_Changed" Unchecked="TranscriptView_Changed"/>
            </WrapPanel>
            <TextBlock x:Name="PrivacyLabel" Text="Temporary · This conversation is not saved." TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock Text="Runs on this PC. Older turns leave the model's context as it fills. Replies may be inaccurate." TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/>
            <Grid x:Name="BranchPanel" Margin="0,8,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="BranchSelector" MinHeight="32" DisplayMemberPath="Label" SelectionChanged="BranchSelector_SelectionChanged" AutomationProperties.Name="Continue from a turn"/>
                <WrapPanel Grid.Column="1">
                    <Button x:Name="EditTurnButton" Content="Edit" Click="EditTurn_Click" MinHeight="32" Padding="8,0" Margin="6,0,0,0"/>
                    <Button x:Name="RegenerateButton" Content="Regenerate" Click="Regenerate_Click" MinHeight="32" Padding="8,0" Margin="6,0,0,0"/>
                </WrapPanel>
            </Grid>
        </StackPanel>
        <Grid Grid.Row="2">
        <TextBox x:Name="TranscriptText" IsReadOnly="True" IsUndoEnabled="False"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12"
                 FontSize="15" AutomationProperties.Name="Conversation, plain text"
                 AutomationProperties.AutomationId="ChatTranscript"/>
        <FlowDocumentScrollViewer x:Name="FormattedTranscript" IsToolBarVisible="False" IsSelectionEnabled="True"
                                  VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Formatted conversation"/>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <Label Content="_Message" Target="{Binding ElementName=MessageInput}" Padding="0,0,0,6"/>
            <TextBox x:Name="MessageInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="140"
                     VerticalScrollBarVisibility="Auto" Padding="8" MaxLength="2000" IsUndoEnabled="False"
                     PreviewKeyDown="MessageInput_PreviewKeyDown" TextChanged="MessageInput_TextChanged"
                     AutomationProperties.AutomationId="ChatMessage"/>
            <TextBlock Text="Enter to send · Shift+Enter for a new line · Up to 2,000 characters" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        <TextBlock Grid.Row="4" x:Name="StatusLabel" Text="The local model loads when you send your first message."
                   TextWrapping="Wrap" Margin="0,12,0,12" AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.AutomationId="ChatStatus"/>
        <WrapPanel Grid.Row="5" HorizontalAlignment="Right">
            <Button x:Name="CopyReplyButton" Content="Copy reply" Click="CopyReply_Click" MinHeight="36" Padding="8,0" Margin="0,0,8,6"/>
            <Button x:Name="SaveRetryButton" Content="Retry saving" Click="SaveRetry_Click" Visibility="Collapsed" MinHeight="36" Padding="8,0" Margin="0,0,8,6"/>
            <Button x:Name="ContinueTemporaryButton" Content="Continue temporarily" Click="ContinueTemporary_Click" Visibility="Collapsed" MinHeight="36" Padding="8,0" Margin="0,0,8,6"
                    ToolTip="Keep this reply in a temporary chat. Earlier saved messages remain on this PC."/>
            <Button x:Name="NewConversationButton" Content="_New conversation" Click="NewConversation_Click"
                    MinHeight="36" Padding="10,0" Margin="0,0,8,6"/>
            <Button x:Name="RetryButton" Content="Edit and _retry" Click="Retry_Click" Visibility="Collapsed"
                    MinHeight="36" Padding="10,0" Margin="0,0,8,6"/>
            <Button x:Name="StopButton" Content="S_top" Click="Stop_Click" IsEnabled="False" MinWidth="72"
                    MinHeight="36" Margin="0,0,8,6" AutomationProperties.AutomationId="StopChat"/>
            <Button x:Name="SendButton" Content="_Send" Click="Send_Click" IsEnabled="False" MinWidth="80"
                    MinHeight="36" Margin="0,0,0,6" AutomationProperties.AutomationId="SendChat"/>
        </WrapPanel>
        </Grid>
    </Grid>
</Window>
