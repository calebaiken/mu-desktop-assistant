<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Explicit keys: importing these resources never restyles unrelated windows. -->
    <FontFamily x:Key="Mu.InterfaceFont">Inter, Segoe UI</FontFamily>
    <FontFamily x:Key="Mu.DisplayFont">EB Garamond, Georgia</FontFamily>
    <FontFamily x:Key="Mu.TechnicalFont">JetBrains Mono, Consolas</FontFamily>
    <Style x:Key="Mu.FocusVisual" TargetType="Control">
        <Setter Property="Template"><Setter.Value><ControlTemplate>
            <Border Margin="-4" BorderThickness="2" CornerRadius="6" BorderBrush="{DynamicResource Mu.Focus}"/>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Mu.Button" TargetType="Button">
        <Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="16,8"/>
        <Setter Property="Background" Value="{DynamicResource Mu.Surface}"/><Setter Property="Foreground" Value="{DynamicResource Mu.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Mu.ControlBorder}"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Mu.FocusVisual}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Mu.Focus}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Mu.SecondaryText}"/><Setter Property="Background" Value="{DynamicResource Mu.Raised}"/><Setter Property="BorderBrush" Value="{DynamicResource Mu.QuietBorder}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Mu.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Mu.Button}">
        <Setter Property="Background" Value="{DynamicResource Mu.Primary}"/><Setter Property="BorderBrush" Value="{DynamicResource Mu.Primary}"/>
        <Setter Property="Foreground" Value="{DynamicResource Mu.OnPrimary}"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Mu.PrimaryHover}"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="Mu.TextBox" TargetType="TextBox">
        <Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="12,8"/>
        <Setter Property="Background" Value="{DynamicResource Mu.Surface}"/><Setter Property="Foreground" Value="{DynamicResource Mu.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Mu.ControlBorder}"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Mu.Text}"/><Setter Property="SelectionBrush" Value="{DynamicResource Mu.Primary}"/>
        <Setter Property="SelectionTextBrush" Value="{DynamicResource Mu.OnPrimary}"/>
        <Setter Property="IsUndoEnabled" Value="False"/><Setter Property="FocusVisualStyle" Value="{StaticResource Mu.FocusVisual}"/>
        <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Mu.Focus}"/><Setter Property="BorderThickness" Value="2"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="Mu.ProjectItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,4"/><Setter Property="Margin" Value="4"/>
        <Setter Property="Background" Value="{DynamicResource Mu.Surface}"/><Setter Property="Foreground" Value="{DynamicResource Mu.Text}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Mu.FocusVisual}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleLabel}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Chrome" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Mu.QuietBorder}" BorderThickness="1" CornerRadius="6">
                <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Mu.Raised}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Mu.Primary}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/><Setter Property="Background" Value="{DynamicResource Mu.Raised}"/></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Mu.Focus}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Mu.ComboBox" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="44"/><Setter Property="MinWidth" Value="156"/>
        <Setter Property="Background" Value="{DynamicResource Mu.Surface}"/><Setter Property="Foreground" Value="{DynamicResource Mu.Text}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Mu.FocusVisual}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
            <Grid>
                <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
                </ToggleButton>
                <Border IsHitTestVisible="False" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Mu.ControlBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="⌄" Margin="12,0,0,0"/><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center"/></DockPanel>
                </Border>
                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                    <Border Background="{DynamicResource Mu.Surface}" BorderBrush="{DynamicResource Mu.ControlBorder}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                        <ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
        <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,10"/><Setter Property="Foreground" Value="{DynamicResource Mu.Text}"/><Setter Property="Background" Value="{DynamicResource Mu.Surface}"/>
            <Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource Mu.Primary}"/><Setter Property="Foreground" Value="{DynamicResource Mu.OnPrimary}"/></Trigger></Style.Triggers>
        </Style></Setter.Value></Setter>
    </Style>
    <Style x:Key="Mu.ScrollBar" TargetType="ScrollBar">
        <!-- Only the vertical template is opted in here; horizontal platform behavior remains native. -->
        <Style.Triggers><Trigger Property="Orientation" Value="Vertical">
            <Setter Property="Width" Value="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Border Background="{DynamicResource Mu.Surface}">
                    <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                           Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}"
                           Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Focusable="False">
                            <RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                        </RepeatButton></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb MinHeight="32">
                            <Thumb.Template><ControlTemplate TargetType="Thumb">
                                <Border x:Name="Handle" Background="{DynamicResource Mu.ControlBorder}" CornerRadius="4" Margin="4,2"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Background" Value="{DynamicResource Mu.Focus}"/></Trigger>
                                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="Handle" Property="Background" Value="{DynamicResource Mu.Primary}"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></Thumb.Template>
                        </Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Focusable="False">
                            <RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                        </RepeatButton></Track.IncreaseRepeatButton>
                    </Track>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Trigger></Style.Triggers>
    </Style>
</ResourceDictionary>
