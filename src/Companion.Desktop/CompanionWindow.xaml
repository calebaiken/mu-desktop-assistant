<Window x:Class="Companion.Desktop.CompanionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Companion.Desktop.Controls"
        Title="Desktop Companion" Width="260" Height="320" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" PreviewKeyDown="Window_PreviewKeyDown"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Window.Resources>
        <Style x:Key="MovementFocus" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="2" StrokeThickness="2" StrokeDashArray="2 2"
                                   Stroke="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Margin="12" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
            BorderThickness="1" CornerRadius="28" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="NameLabel" Text="Pip" FontSize="22" FontWeight="SemiBold"
                       TextAlignment="Center" TextTrimming="CharacterEllipsis" />
            <controls:MovementSurface x:Name="DragSurface" Grid.Row="1" Background="Transparent" Cursor="SizeAll"
                    Focusable="True" FocusVisualStyle="{StaticResource MovementFocus}" Margin="0,10" MouseLeftButtonDown="DragSurface_MouseLeftButtonDown"
                    MouseMove="DragSurface_MouseMove" MouseLeftButtonUp="DragSurface_MouseLeftButtonUp"
                    LostMouseCapture="DragSurface_LostMouseCapture" KeyDown="DragSurface_KeyDown"
                    ToolTip="Drag to move. Use arrow keys when focused; Shift moves farther. Ctrl+Shift+M moves to the next display."
                    AutomationProperties.Name="Move companion"
                    AutomationProperties.HelpText="Drag to move, or use arrow keys. Hold Shift to move farther. Ctrl+Shift+M moves to the next display."
                    AutomationProperties.AutomationId="MoveCompanion">
            <StackPanel VerticalAlignment="Center">
                <Viewbox x:Name="AvatarVisual" Width="140" Height="110" IsHitTestVisible="False">
                    <controls:DefaultAvatarRenderer x:Name="AvatarRenderer" />
                </Viewbox>
                <TextBlock x:Name="StateLabel" Text="Ready" Margin="0,12,0,0" TextAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="AvatarState" />
            </StackPanel>
            </controls:MovementSurface>
            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                <TextBlock x:Name="MovementStatus" Text="Drag to move · Arrow keys when focused"
                           TextWrapping="Wrap" TextAlignment="Center" />
                <TextBlock x:Name="DesktopStatus" TextWrapping="Wrap" TextAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="DesktopStatus" />
            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="_Settings" MinHeight="34" MinWidth="100" Margin="0,0,8,0"
                        Click="Settings_Click" AutomationProperties.AutomationId="OpenSettings" />
                <Button Content="E_xit" MinHeight="34" MinWidth="66" Click="Exit_Click"
                        AutomationProperties.AutomationId="ExitCompanion" />
            </StackPanel>
        </Grid>
    </Border>
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="_Chat" InputGestureText="Ctrl+Shift+C" Click="Chat_Click" />
            <MenuItem Header="_Settings" Click="Settings_Click" />
            <MenuItem Header="_Hide" Click="Hide_Click" />
            <MenuItem Header="_Next display" InputGestureText="Ctrl+Shift+M" Click="NextMonitor_Click" />
            <MenuItem x:Name="SleepMenuItem" Header="_Sleep" Click="Sleep_Click" />
            <Separator />
            <MenuItem Header="E_xit" Click="Exit_Click" />
        </ContextMenu>
    </Window.ContextMenu>
</Window>
