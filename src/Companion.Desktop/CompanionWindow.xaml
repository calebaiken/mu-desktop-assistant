<Window x:Class="Companion.Desktop.CompanionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Companion" Width="260" Height="320" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <Border Margin="12" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
            BorderThickness="1" CornerRadius="28" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="NameLabel" Text="Pip" FontSize="22" FontWeight="SemiBold"
                       TextAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Viewbox Grid.Row="1" Margin="20,14" IsHitTestVisible="False">
                <Grid Width="140" Height="110">
                    <Border Background="#DDEAE6" BorderBrush="#55766D" BorderThickness="2"
                            CornerRadius="45" />
                    <Ellipse Fill="#24483D" Width="10" Height="16" Margin="-45,-4,0,0" />
                    <Ellipse Fill="#24483D" Width="10" Height="16" Margin="45,-4,0,0" />
                    <Path Data="M 53,69 Q 70,84 87,69" Stroke="#24483D" StrokeThickness="3" />
                </Grid>
            </Viewbox>
            <TextBlock Grid.Row="2" Text="A little space on your desktop."
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16" />
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="_Settings" MinHeight="34" MinWidth="100" Margin="0,0,8,0"
                        Click="Settings_Click" AutomationProperties.AutomationId="OpenSettings" />
                <Button Content="E_xit" MinHeight="34" MinWidth="66" Click="Exit_Click"
                        AutomationProperties.AutomationId="ExitCompanion" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
