<Window x:Class="Companion.Desktop.CompanionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Companion.Desktop.Controls"
        Title="Desktop Companion" Icon="/Companion.Desktop;component/Assets/Mu.ico" Width="136" Height="132" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" PreviewKeyDown="Window_PreviewKeyDown"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Window.Resources>
        <Style x:Key="MovementFocus" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="2" RadiusX="24" RadiusY="24" StrokeThickness="2" StrokeDashArray="2 2"
                                   Stroke="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CompanionAction" TargetType="Button">
            <Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2,0" /><Setter Property="Padding" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionChrome" Background="{TemplateBinding Background}" CornerRadius="10"
                                BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionChrome" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionChrome" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ActionChrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="CompanionRoot">
        <!-- A painted connector exists only while actions are visible. It keeps the
             native layered-window pointer path continuous below a round particle. -->
        <Border x:Name="HoverBridge" Width="10" Height="44" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,46" CornerRadius="4" BorderThickness="1" IsHitTestVisible="False"
                Background="#DDEAE6" BorderBrush="#24483D"
                Visibility="{Binding ElementName=HoverControls, Path=Visibility}"/>
        <!-- Only character pixels are painted at rest. -->
        <controls:MovementSurface x:Name="DragSurface" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="8,8,8,0" Background="Transparent" Cursor="SizeAll" Focusable="True"
                FocusVisualStyle="{StaticResource MovementFocus}" KeyboardNavigation.TabIndex="0"
                MouseLeftButtonDown="DragSurface_MouseLeftButtonDown" MouseMove="DragSurface_MouseMove"
                MouseLeftButtonUp="DragSurface_MouseLeftButtonUp" LostMouseCapture="DragSurface_LostMouseCapture"
                KeyDown="DragSurface_KeyDown" AutomationProperties.Name="Move companion"
                AutomationProperties.HelpText="Drag to move, or use arrow keys. Press Tab for Chat, Settings and More. Hold Shift to move farther. Ctrl+Shift+M moves to the next display."
                AutomationProperties.AutomationId="MoveCompanion">
            <Viewbox x:Name="AvatarVisual" Width="112" Height="88" IsHitTestVisible="False">
                <controls:DefaultAvatarRenderer x:Name="AvatarRenderer" />
            </Viewbox>
        </controls:MovementSurface>
        <!-- The lower toolbar and hover-only connector provide a continuous pointer path. -->
        <Border x:Name="HoverControls" Width="124" Height="42" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,4" CornerRadius="16" Padding="4" Visibility="Hidden" IsHitTestVisible="False"
                Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="ChatButton" Style="{StaticResource CompanionAction}" Click="Chat_Click"
                        ToolTip="Chat" AutomationProperties.Name="Chat" AutomationProperties.AutomationId="OpenChat" KeyboardNavigation.TabIndex="1">
                    <Path Data="M 2,2 L 14,2 Q 16,2 16,4 L 16,10 Q 16,12 14,12 L 7,12 L 3,16 L 3,12 Q 1,12 1,10 L 1,4 Q 1,2 2,2"
                          Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.5" StrokeLineJoin="Round"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button x:Name="SettingsButton" Style="{StaticResource CompanionAction}" Click="Settings_Click"
                        ToolTip="Settings" AutomationProperties.Name="Settings" AutomationProperties.AutomationId="OpenSettings" KeyboardNavigation.TabIndex="2">
                    <Path Data="M 6,1 L 10,1 L 11,4 L 14,4 L 16,8 L 14,12 L 11,12 L 10,15 L 6,15 L 5,12 L 2,12 L 0,8 L 2,4 L 5,4 Z M 11,8 A 3,3 0 1 0 5,8 A 3,3 0 1 0 11,8"
                          Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button x:Name="MoreButton" Style="{StaticResource CompanionAction}" Click="More_Click"
                        ToolTip="More: hide, sleep or exit" AutomationProperties.Name="More actions" AutomationProperties.AutomationId="MoreCompanionActions" KeyboardNavigation.TabIndex="3">
                    <Path Data="M 2,8 A 1,1 0 1 0 4,8 A 1,1 0 1 0 2,8 M 7,8 A 1,1 0 1 0 9,8 A 1,1 0 1 0 7,8 M 12,8 A 1,1 0 1 0 14,8 A 1,1 0 1 0 12,8"
                          Width="16" Height="16" Stretch="None" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </StackPanel>
        </Border>
        <Border x:Name="StatusBadge" Width="18" Height="18" CornerRadius="9" VerticalAlignment="Top" HorizontalAlignment="Right"
                Margin="0,5,5,0" Visibility="Collapsed" Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}" BorderThickness="1"
                ToolTip="{Binding Text, ElementName=DesktopStatus}" AutomationProperties.Name="Companion notice">
            <TextBlock Text="!" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}" />
        </Border>
        <!-- State fields stay available to diagnostics; details move to tooltip/menu. -->
        <StackPanel Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="NameLabel" Text="Mu" />
            <TextBlock x:Name="StateLabel" Text="Ready" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="MovementStatus" Text="Drag to move · Arrow keys when focused" />
            <TextBlock x:Name="DesktopStatus" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Grid>
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="NoticeMenuItem" Visibility="Collapsed" IsEnabled="False">
                <MenuItem.Header><TextBlock x:Name="NoticeMenuText" MaxWidth="240" TextWrapping="Wrap" /></MenuItem.Header>
            </MenuItem>
            <MenuItem Header="_Chat" InputGestureText="Ctrl+Shift+C" Click="Chat_Click" />
            <MenuItem Header="Machine _Learning Lab" Click="MlLab_Click" />
            <MenuItem Header="_Inspect text file…" Click="InspectText_Click" />
            <MenuItem Header="_Settings" Click="Settings_Click" />
            <MenuItem Header="_Hide" Click="Hide_Click" />
            <MenuItem Header="_Next display" InputGestureText="Ctrl+Shift+M" Click="NextMonitor_Click" />
            <MenuItem x:Name="SleepMenuItem" Header="_Sleep" Click="Sleep_Click" />
            <Separator />
            <MenuItem Header="E_xit" Click="Exit_Click" />
        </ContextMenu>
    </Window.ContextMenu>
</Window>
