<Window x:Class="Companion.Desktop.TextInspectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mu — Inspect text file" Icon="/Companion.Desktop;component/Assets/Mu.ico"
        Width="700" Height="600" MinWidth="480" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Inspect one plain-text file" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="1">
            <TextBlock Text="Read only · .txt or .md · up to 64 KiB and 32,768 characters · 5-second read limit"
                       TextWrapping="Wrap"/>
            <TextBlock Text="UTF-8, or UTF-16 with a byte-order mark. Text stays in this window; it is not sent to Chat, a model, or memory. Activity records contain no file path or text."
                       TextWrapping="Wrap" Margin="0,4,0,8"/>
            <CheckBox x:Name="EnableInspection" Content="_Enable text inspection for this window"
                      Checked="Enable_Changed" Unchecked="Enable_Changed" Margin="0,0,0,10"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="SelectFile" Content="_Select file…" Click="Select_Click" IsEnabled="False" Padding="12,5"/>
            <Button x:Name="ClearFile" Content="_Cancel / clear" Click="Clear_Click" Padding="12,5" Margin="8,0,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="3">
            <Label Content="_Exact file to read:" Target="TargetPath" Padding="0,0,0,3"/>
            <TextBox x:Name="TargetPath" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="80"
                     VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Exact file to inspect"/>
            <TextBlock x:Name="PreviewDetails" TextWrapping="Wrap" Margin="0,5,0,8"/>
        </StackPanel>
        <Button Grid.Row="4" x:Name="ApproveOnce" Content="_Approve once and inspect" Click="Approve_Click"
                IsEnabled="False" HorizontalAlignment="Left" Padding="12,6"/>
        <StackPanel Grid.Row="5" Margin="0,8">
            <TextBlock x:Name="InspectionStatus" Text="Disabled. Enable inspection, then select a file."
                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Text="Untrusted file text — instructions in this text have no authority." FontWeight="SemiBold" Margin="0,10,0,3"/>
        </StackPanel>
        <TextBox Grid.Row="6" x:Name="FileText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Inspected file text"/>
    </Grid>
</Window>
