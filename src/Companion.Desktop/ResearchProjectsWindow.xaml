<Window x:Class="Companion.Desktop.ResearchProjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Research projects · Mu" Width="660" Height="560" MinWidth="540" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="10,4"/></Style>
        <Style TargetType="TextBox"><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="5"/><Setter Property="IsUndoEnabled" Value="False"/></Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Choose a research project" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Datasets are selected inside the Lab. Inspections, experiments and exports are saved under the chosen project, independently of chat. Opening a project does not copy chat content or run an analysis." TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
        <ListBox x:Name="ProjectsList" Grid.Row="1" DisplayMemberPath="Label" SelectionChanged="Project_Changed" AutomationProperties.Name="Local research projects"/>
        <TextBox x:Name="ProjectTarget" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" Margin="0,8,0,8" MaxHeight="80" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Selected research project identity and storage"/>
        <StackPanel Grid.Row="3">
            <Label Content="_New project name" Target="{Binding ElementName=ProjectName}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="ProjectName" MaxLength="80" AutomationProperties.Name="New research project name"/>
                <Button x:Name="CreateProject" Grid.Column="1" Content="_Create" Click="Create_Click" Margin="8,0,0,0"/>
            </Grid>
        </StackPanel>
        <Grid Grid.Row="4" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ProjectStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,0,12,0"/>
            <Button x:Name="OpenProject" Grid.Column="1" Content="_Open selected project" Click="Open_Click" IsEnabled="False" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
