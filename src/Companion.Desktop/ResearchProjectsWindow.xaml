<Window x:Class="Companion.Desktop.ResearchProjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Research projects · Mu" Width="800" Height="680" MinWidth="540" MinHeight="460"
        WindowStartupLocation="CenterOwner" SizeChanged="Layout_Changed"
        Background="{DynamicResource Mu.Canvas}" Foreground="{DynamicResource Mu.Text}"
        FontFamily="{DynamicResource Mu.InterfaceFont}" FontSize="14" KeyboardNavigation.TabNavigation="Cycle">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Mu.Instrument.xaml"/>
                <ResourceDictionary Source="Resources/Mu.Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource Mu.ScrollBar}"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="MU / RESEARCH" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Mu.Accent}"/>
                <TextBlock Text="Research projects" FontFamily="{DynamicResource Mu.DisplayFont}" FontSize="30" Margin="0,4,16,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Label Content="_Reading mode" Target="{Binding ElementName=ThemeModeSelector}" Foreground="{DynamicResource Mu.SecondaryText}" Padding="0,0,0,4" FontSize="12"/>
                <ComboBox x:Name="ThemeModeSelector" Style="{StaticResource Mu.ComboBox}" SelectedIndex="0" SelectionChanged="Theme_Changed"
                          AutomationProperties.Name="Research projects reading mode" AutomationProperties.HelpText="Only this window. Windows high contrast takes priority.">
                    <ComboBoxItem Content="Instrument · dark"/><ComboBoxItem Content="Archive · light"/>
                </ComboBox>
            </StackPanel>
        </Grid>
        <ScrollViewer x:Name="ProjectBodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,8,4">
            <StackPanel>
                <TextBlock Text="Datasets are chosen in the Lab. Inspections, experiments and exports stay local to the project. Opening a project transfers no chat and runs no analysis."
                           TextWrapping="Wrap" Foreground="{DynamicResource Mu.SecondaryText}" Margin="0,0,0,8"/>
                <Grid x:Name="ProjectLayout">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
                    <StackPanel x:Name="CatalogPanel">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="LOCAL PROJECTS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Mu.Accent}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ProjectCountLabel" Text="Catalog not loaded" Foreground="{DynamicResource Mu.SecondaryText}" HorizontalAlignment="Right" FontSize="12"/>
                        </DockPanel>
                        <TextBlock x:Name="BusyProjectsLabel" Text="Loading projects…" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
                        <ListBox x:Name="ProjectsList" SelectionChanged="Project_Changed" PreviewKeyDown="Projects_KeyDown"
                                 MinHeight="112" MaxHeight="160" Background="{DynamicResource Mu.Canvas}" Foreground="{DynamicResource Mu.Text}"
                                 BorderBrush="{DynamicResource Mu.ControlBorder}" BorderThickness="1" Padding="2"
                                 ItemContainerStyle="{StaticResource Mu.ProjectItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 FocusVisualStyle="{StaticResource Mu.FocusVisual}" AutomationProperties.Name="Local research projects">
                            <ListBox.ItemTemplate><DataTemplate><StackPanel>
                                <TextBlock Text="{Binding Project.Name}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Identity}" FontFamily="{DynamicResource Mu.TechnicalFont}" FontSize="12" Foreground="{DynamicResource Mu.SecondaryText}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <Border x:Name="EmptyProjectsPanel" Visibility="Collapsed" Padding="16" Background="{DynamicResource Mu.Surface}" BorderBrush="{DynamicResource Mu.QuietBorder}" BorderThickness="1" CornerRadius="10" Margin="0,8,0,0">
                            <StackPanel><TextBlock Text="A place for your first study" FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock Text="Create a project below. No dataset is needed yet." Foreground="{DynamicResource Mu.SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border x:Name="SelectionPanel" Grid.Row="1" Background="{DynamicResource Mu.Surface}" BorderBrush="{DynamicResource Mu.QuietBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="DESTINATION REVIEW" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Mu.Accent}"/>
                            <TextBlock x:Name="SelectionHeading" Text="No project selected" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,6" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SelectionHint" Text="Select a project to review its identity and exact storage location." Foreground="{DynamicResource Mu.SecondaryText}" TextWrapping="Wrap"/>
                            <TextBox x:Name="ProjectTarget" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="0" MaxHeight="96" Visibility="Collapsed"
                                     Style="{StaticResource Mu.TextBox}" FontFamily="{DynamicResource Mu.TechnicalFont}" FontSize="13" Margin="0,8,0,0"
                                     AutomationProperties.Name="Selected research project identity and storage"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Height="1" Background="{DynamicResource Mu.QuietBorder}" Margin="0,12,0,8"/>
                <Label Content="_New project name" Target="{Binding ElementName=ProjectName}" Foreground="{DynamicResource Mu.Text}" Padding="0,0,0,4" FontWeight="SemiBold"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="ProjectName" MaxLength="80" Style="{StaticResource Mu.TextBox}" TextChanged="Name_Changed" PreviewKeyDown="Name_KeyDown"
                             AutomationProperties.Name="New research project name" AutomationProperties.HelpText="1 to 80 characters. Creating a project writes local metadata; it opens no dataset."/>
                    <Button x:Name="CreateProject" Grid.Column="1" Content="_Create" Style="{StaticResource Mu.Button}" Click="Create_Click" Margin="8,0,0,0" IsEnabled="False"/>
                </Grid>
                <TextBlock x:Name="NameValidation" Text="Up to 32 named projects, plus the original Lab location." Foreground="{DynamicResource Mu.SecondaryText}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <Border Background="{DynamicResource Mu.Raised}" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                <TextBlock x:Name="ProjectStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Project selection status"/>
            </Border>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="RetryProjectsButton" Content="_Refresh" Click="Retry_Click" Style="{StaticResource Mu.Button}" HorizontalAlignment="Left" AutomationProperties.HelpText="Reload the project catalog. Clears the selection."/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CancelProjectsButton" Content="_Cancel" IsCancel="True" Click="Cancel_Click" Style="{StaticResource Mu.Button}" Margin="8,0,8,0"/>
                    <Button x:Name="OpenProject" Content="_Open selected project" Click="Open_Click" IsEnabled="False" Style="{StaticResource Mu.PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
